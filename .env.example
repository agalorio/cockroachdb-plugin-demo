# =============================================================================
# Image tags
# Pin versions so everyone in the lab runs the same stack.
# Geneos tags match the 5 August 2026 Docker Images release:
# https://docs.itrsgroup.com/docs/all/geneos/deployments/docker-images/index.html
# CockroachDB plugin needs Gateway/Netprobe 7.11.x+ and Collection Agent 6.6.x+.
# =============================================================================

# Geneos Gateway image (ITRS registry; requires docker login docker.itrsgroup.com)
GATEWAY_IMAGE=docker.itrsgroup.com/gateway:7.11.1-r0

# Geneos Netprobe image (also the source of Collection Agent plugin JARs)
NETPROBE_IMAGE=docker.itrsgroup.com/netprobe:7.11.1-r0

# Standalone Collection Agent image (Java 21)
COLLECTION_AGENT_IMAGE=docker.itrsgroup.com/collection/collection-agent:6.6.3-jre21-r0

# Single-node CockroachDB (public Docker Hub image)
COCKROACH_IMAGE=cockroachdb/cockroach:v26.2.2

# =============================================================================
# Docker network and container names
# These become DNS names on the user-defined bridge (other containers use them).
# =============================================================================

NETWORK_NAME=geneos-lab
COCKROACH_CONTAINER=cockroach
GATEWAY_CONTAINER=gateway
NETPROBE_CONTAINER=netprobe
COLLECTION_AGENT_CONTAINER=collection-agent

# =============================================================================
# Ports published to your host (Active Console, DB Console, debugging)
# Inside the Docker network, containers still talk on the container ports below.
# =============================================================================

# Gateway insecure listen port (Active Console connects here)
GATEWAY_PORT=7039

# Netprobe listen port (SAN still listens; useful for docker logs / debugging)
NETPROBE_PORT=7036

# TCP reporter: Collection Agent -> Netprobe (unmanaged Collection Agent)
TCP_REPORTER_PORT=9137

# CockroachDB SQL (PostgreSQL wire protocol / JDBC)
COCKROACH_SQL_PORT=26257

# CockroachDB HTTP Status/Admin API and DB Console
COCKROACH_HTTP_PORT=8080

# Collection Agent health probe (container-internal; optional to publish)
CA_HEALTH_PORT=9136
